# Kopieer naar .env (staat in .gitignore). Lokaal werkt alles zonder .env op fixtures.

# --- Poorten (per stuk een eigen poort om botsingen te voorkomen) ---
HZ_API_PORT=8700
HZ_WEB_PORT=5700

# --- Data ---
# demo (prototype-demodata, vaste klok 30 okt 2026 08:40) | harness (zelfde nep-bronnen als de lat met echte context)
HZ_FIXTURE_SET=demo
# Vaste wandklok (JJJJ-MM-DDTHH:MM) of "now"
# HZ_NOW=now
# Echte contextdata ALLEEN runtime laden, nooit committen:
# HZ_CONTEXT_EXPORT=/pad/naar/ctx-export
# of de repo's zelf (alleen lezen):
# HZ_CONTEXT_REPO=/home/user/homezero-context
# HZ_PERSOONLIJK_REPO=/home/user/context-prive

# --- Opslag ---
# memory (standaard) | db (Postgres met RLS)
HZ_STORE=memory
DATABASE_URL=postgres://hz_dev:hz_dev@localhost:5432/hz_fundament
# Productie: DATABASE_URL = de app-login (sql/app-login.sql; createDb() weigert anders), en pg-boss met een eigen login
# die alleen eigenaar is van schema pgboss (sql/boss-login.sql; nooit de migratierol, de worker weigert dan te starten):
# HZ_BOSS_DATABASE_URL=postgres://hz_boss:...@host:5432/hz
# HZ_BOSS_SCHEMA=pgboss
# Indexer (indexjob van de contextlaag, importscript): login die alleen lid is van hz_indexer (sql/indexer-login.sql):
# HZ_INDEX_DATABASE_URL=postgres://hz_indexer_login:...@host:5432/hz
# 32 bytes base64 voor de envelope-versleuteling van koppel-tokens: openssl rand -base64 32
# HZ_TOKEN_KEY=

# --- Inloggen (dev-login-stub alleen in development/test; nooit in productie) ---
HZ_DEV_LOGIN=1
HZ_DEV_EMAIL=robert@homezero.nl
HZ_ALLOWED_DOMAIN=homezero.nl

# --- Inloggen met Google en koppelingen (stuk E1; secrets alleen in de server-secrets, nooit in Git) ---
# Publieke basis-URL voor de redirect-URI's (productie verplicht, https)
# HZ_PUBLIC_URL=https://homezero.verveen.me
# Geheim voor Auth.js (state/PKCE/CSRF-cookies): openssl rand -base64 32
# HZ_AUTH_SECRET=
# Eén Google OAuth-client (type Intern): inloggen + Taken, Agenda, Gmail
# HZ_GOOGLE_CLIENT_ID=
# HZ_GOOGLE_CLIENT_SECRET=
# HZ_SLACK_CLIENT_ID=
# HZ_SLACK_CLIENT_SECRET=
# HZ_ATLASSIAN_CLIENT_ID=
# HZ_ATLASSIAN_CLIENT_SECRET=
# HZ_GITHUB_CLIENT_ID=
# HZ_GITHUB_CLIENT_SECRET=
# Wie mag inloggen (naast de tabel allowlist, te beheren in Instellingen → Team). Beheerders: met Postgres via de
# allowlist (rol admin; robert@homezero.nl vast), HZ_ADMIN_EMAILS alleen voor HZ_STORE=memory
# HZ_ALLOWLIST=lisanne@homezero.nl
# HZ_ADMIN_EMAILS=robert@homezero.nl
# Alleen lokaal/tests: alles tegen de nep-autorisatieserver (pnpm --filter @hz/fake-oauth start, poort 8764)
# HZ_OAUTH_ENDPOINTS=http://127.0.0.1:8764
# HZ_GOOGLE_ISSUER=http://127.0.0.1:8764/google

# --- Live koppelingen (lege schillen tot de koppelingsstukken er zijn) ---
# HZ_LIVE_CALENDAR=1
# HZ_LIVE_GMAIL=1
# HZ_LIVE_TASKS=1
# HZ_LIVE_SLACK=1
# HZ_LIVE_JIRA=1
# HZ_LIVE_WISPR=1
# HZ_LIVE_ANTHROPIC=1
# ANTHROPIC_API_KEY=
