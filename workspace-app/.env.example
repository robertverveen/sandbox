# Kopieer naar .env (staat in .gitignore). Lokaal werkt alles zonder .env op fixtures.

# --- Poorten (per stuk een eigen poort om botsingen te voorkomen) ---
HZ_API_PORT=8700
HZ_WEB_PORT=5700

# --- Data ---
# demo (prototype-demodata, vaste klok 30 okt 2026 08:40) | harness (zelfde nep-bronnen als de lat met echte context)
HZ_FIXTURE_SET=demo
# Vaste wandklok (JJJJ-MM-DDTHH:MM) of "now"
# HZ_NOW=now
# Echte contextdata ALLEEN runtime laden, nooit committen:
# HZ_CONTEXT_EXPORT=/pad/naar/ctx-export
# of de repo's zelf (alleen lezen):
# HZ_CONTEXT_REPO=/home/user/homezero-context
# HZ_PERSOONLIJK_REPO=/home/user/context-prive

# --- Opslag ---
# memory (standaard) | db (Postgres met RLS)
HZ_STORE=memory
DATABASE_URL=postgres://hz_dev:hz_dev@localhost:5432/hz_fundament
# 32 bytes base64 voor de envelope-versleuteling van koppel-tokens: openssl rand -base64 32
# HZ_TOKEN_KEY=

# --- Inloggen (stub tot het auth-stuk er is; nooit in productie) ---
HZ_DEV_LOGIN=1
HZ_DEV_EMAIL=robert@homezero.nl
HZ_ALLOWED_DOMAIN=homezero.nl

# --- Live koppelingen (stuk E3; tokens per collega versleuteld in Postgres, dus HZ_STORE=db en HZ_TOKEN_KEY) ---
# HZ_LIVE_CALENDAR=1
# HZ_LIVE_GMAIL=1
# HZ_LIVE_TASKS=1
# HZ_LIVE_SLACK=1
# HZ_LIVE_JIRA=1
# HZ_LIVE_WISPR=1
# HZ_LIVE_GITHUB=1
# OAuth-clients om tokens op de server te verversen (secrets, nooit in Git):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Jira: site en project van het sprintbord
# HZ_JIRA_SITE=homezero.atlassian.net
# HZ_JIRA_PROJECT=HOM
# Wispr Flow MCP-endpoint (streamable HTTP)
# HZ_WISPR_MCP_URL=
# Contextlaag via GitHub (owner/repo)
# HZ_GITHUB_CONTEXT_REPO=HomeZeroTech/HomeZero-context
# HZ_GITHUB_PERSOONLIJK_REPO=
# Push naar de sync-motor: publieke basis-URL, geheimen voor webhooks
# HZ_PUBLIC_URL=https://homezero.verveen.me
# HZ_HOOK_SECRET=
# HZ_SLACK_SIGNING_SECRET=
# HZ_GMAIL_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# Spike HZW-037: Slack-to-do's naast Google Taken (herinneringen en gekoppelde Lists)
# HZ_SLACK_TODOS=1
# HZ_SLACK_TODO_LISTS=F0…:Mijn to-do
# HZ_LIVE_ANTHROPIC=1
# ANTHROPIC_API_KEY=
