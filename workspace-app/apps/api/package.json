{
  "name": "@hz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./config": "./src/config.ts",
    "./store": "./src/store.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "1.19.6",
    "@hz/context": "workspace:*",
    "@hz/db": "workspace:*",
    "@hz/ops": "workspace:*",
    "@hz/providers": "workspace:*",
    "@hz/shared": "workspace:*",
    "drizzle-orm": "0.44.7",
    "hono": "4.10.8",
    "pg": "8.16.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
