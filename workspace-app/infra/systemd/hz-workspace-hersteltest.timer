# hz-workspace: eigen unit van de HomeZero Workspace (server-setup.sh); botst niet met andere projecten.
[Unit]
Description=HomeZero Workspace: maandelijkse hersteltest, eerste zondag om 04:30 (HZW-008)

[Timer]
OnCalendar=Sun *-*-01..07 04:30:00 Europe/Amsterdam
Persistent=true

[Install]
WantedBy=timers.target
