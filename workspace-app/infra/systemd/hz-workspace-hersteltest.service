# hz-workspace: eigen unit van de HomeZero Workspace (server-setup.sh); botst niet met andere projecten.
[Unit]
Description=HomeZero Workspace: hersteltest van de nieuwste back-up in een lege database (HZW-008)
After=docker.service network-online.target hz-workspace-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=hz-workspace
Group=hz-workspace
ExecStart=/srv/hz-workspace/bin/hz-run hersteltest.sh latest
Nice=10
TimeoutStartSec=2h
