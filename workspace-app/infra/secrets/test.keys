# Sleutels in test.env.age (HZW-006). Per regel: NAAM BRON. BRON gen:hex/gen:b64 vult `secrets.sh gen test` zelf;
# mens:<stap> komt uit HUMAN_INPUT.md (via Chrome). Een ? ervoor = optioneel. Geen waarden in dit bestand.
#
# Database (rollen: infra/postgres/hz-roles.sh)
HZ_PG_SUPERUSER_PASSWORD gen:hex
HZ_PG_MIGRATOR_PASSWORD gen:hex
HZ_PG_APP_PASSWORD gen:hex
HZ_PG_BACKUP_PASSWORD gen:hex
HZ_PG_AUTH_PASSWORD gen:hex
HZ_PG_WORKER_PASSWORD gen:hex
HZ_PG_INDEXER_PASSWORD gen:hex
HZ_PG_BOSS_PASSWORD gen:hex
# Hoofdsleutel voor de envelope-versleuteling van koppel-tokens (32 bytes base64; de API weigert zonder)
HZ_TOKEN_KEY gen:b64
# Inloggen en koppelingen (stuk E1; de API weigert in productie zonder)
HZ_AUTH_SECRET gen:b64
HZ_GOOGLE_CLIENT_ID mens:C5
HZ_GOOGLE_CLIENT_SECRET mens:C5
?HZ_SLACK_CLIENT_ID mens:C6
?HZ_SLACK_CLIENT_SECRET mens:C6
?HZ_ATLASSIAN_CLIENT_ID mens:C7
?HZ_ATLASSIAN_CLIENT_SECRET mens:C7
?HZ_GITHUB_CLIENT_ID mens:C8
?HZ_GITHUB_CLIENT_SECRET mens:C8
?ANTHROPIC_API_KEY mens:C9
?HZ_ALLOWLIST mens:C4
# Foutregistratie (HZW-007): DSN van het project in GlitchTip
?HZ_ERROR_DSN mens:C10
