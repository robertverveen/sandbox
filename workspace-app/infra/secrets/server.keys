# Sleutels in server.env.age: alles wat niet bij één instantie hoort (router, foutregistratie, back-ups, meldingen).
# Per regel: NAAM BRON (zie prod.keys). Geen waarden in dit bestand.
#
# Previews: gebruikersnaam en bcrypt-hash voor basic auth (caddy hash-password); het wachtwoord zelf staat in de
# wachtwoordkluis van het team, niet hier.
HZ_PREVIEW_USER mens:C4
HZ_PREVIEW_HASH mens:C4
# GlitchTip (infra/compose/ops.yaml)
HZ_GLITCHTIP_DB_PASSWORD gen:hex
HZ_GLITCHTIP_SECRET_KEY gen:b64
?HZ_GLITCHTIP_EMAIL_URL mens:C10
# Back-ups naar de Storage Box (HZW-008): sftp://<sub-account>@<box>.your-storagebox.de:23/hz
HZ_BACKUP_TARGET mens:C2
# Uptime-meldingen (healthchecks.io of compatibel): ping-URL's per check (HZW-007, HZW-008)
HZ_HEARTBEAT_PING_URL mens:C10
?HZ_BACKUP_PING_URL mens:C10
?HZ_RESTORE_PING_URL mens:C10
