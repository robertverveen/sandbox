# Edge-proxy van de HomeZero Workspace (HZW-003, HZW-005). Eén Caddy voor de hele server:
# automatische TLS (Let's Encrypt), http -> https, en routering naar de instanties op het Docker-netwerk hz-edge.
#
#   productie   https://{$HZ_DOMAIN}                    -> hz-prod-web:8080
#   test        https://{$HZ_TEST_DOMAIN}               -> hz-test-web:8080
#   preview     https://pr-<nr>.{$HZ_TEST_DOMAIN}       -> hz-pr-<nr>-web:8080   (alleen met wachtwoord)
#   fouten      https://{$HZ_ERRORS_DOMAIN}             -> GlitchTip (ops-stack)
#
# Elke instantie heeft een eigen web-container die de SPA serveert en /api doorzet naar zijn eigen api; de edge kent
# dus per instantie maar één adres. Domeinen staan alleen in /etc/hz/hz.env: verhuizen naar een ander domein is geen
# codewijziging (HZW-082).
{
	email {$HZ_ACME_EMAIL}
	admin localhost:2019
	# Certificaten voor previews worden pas bij het eerste bezoek aangevraagd, en alleen voor een preview die bestaat:
	# preview.sh zet per preview een bestand in /srv/previews (zie de :5555-site onderaan).
	on_demand_tls {
		ask http://127.0.0.1:5555/ask
	}
	servers {
		# Echte client-IP's worden niet gelogd (zie log hieronder); vertrouw geen doorgestuurde headers van buiten.
		trusted_proxies static private_ranges
	}
}

(beveiliging) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
}

# Toegangslog zonder persoonsgegevens: IP gemaskeerd, geen user-agent, geen cookies of autorisatie,
# en OAuth-parameters (code, state) uit de URL.
(log-zonder-pii) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>client_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>headers delete
				resp_headers delete
				request>uri query {
					replace code REDACTED
					replace state REDACTED
					replace token REDACTED
				}
			}
		}
	}
}

{$HZ_DOMAIN} {
	import beveiliging
	import log-zonder-pii
	encode zstd gzip
	reverse_proxy hz-prod-web:8080 {
		health_uri /healthz
		health_interval 30s
	}
}

{$HZ_TEST_DOMAIN} {
	import beveiliging
	import log-zonder-pii
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	reverse_proxy hz-test-web:8080
}

# Preview per pull request: pr-<nr>.{$HZ_TEST_DOMAIN}. Draait op demodata (fixtures, nooit echte data) en is alleen
# met het previewwachtwoord te openen (basic auth; bcrypt-hash in de test-secrets).
*.{$HZ_TEST_DOMAIN} {
	tls {
		on_demand
	}
	import beveiliging
	import log-zonder-pii
	header X-Robots-Tag "noindex, nofollow"
	@preview header_regexp pr Host ^pr-([0-9]{1,6})\.
	handle @preview {
		basic_auth {
			{$HZ_PREVIEW_USER} {$HZ_PREVIEW_HASH}
		}
		encode zstd gzip
		reverse_proxy hz-pr-{re.pr.1}-web:8080
	}
	handle {
		respond "Onbekende preview" 404
	}
}

{$HZ_ERRORS_DOMAIN} {
	import beveiliging
	import log-zonder-pii
	reverse_proxy hz-ops-glitchtip:8000
}

# Alleen binnen de container: mag er voor deze naam een certificaat komen? 200 als preview.sh hem heeft aangemeld.
# SanitizedPathJoin in de file-matcher voorkomt dat een naam als ../../etc/passwd buiten /srv/previews komt.
http://127.0.0.1:5555 {
	bind 127.0.0.1
	@bekend file {
		root /srv/previews
		try_files {query.domain}
	}
	handle /ask {
		respond @bekend 200
		respond 404
	}
	handle {
		respond 404
	}
}

# Healthcheck van de edge zelf (Docker), alleen binnen de container.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}
